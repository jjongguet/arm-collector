{
  "name": "arm-collector",
  "version": "0.1.2",
  "private": false,
  "type": "module",
  "description": "Agent Reliability Monitor collector SDK and CLI (generated read-only mirror of jjongguet/agent-reliability-monitor).",
  "license": "MIT",
  "engines": {
    "node": ">=24.15"
  },
  "bin": {
    "arm-collector": "dist/collector/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/collector/public.d.ts",
      "default": "./dist/collector/public.js"
    },
    "./cli": {
      "types": "./dist/collector/cli.d.ts",
      "default": "./dist/collector/cli.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "node --test tests/*.test.ts",
    "collector": "node dist/collector/cli.js"
  },
  "dependencies": {
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
